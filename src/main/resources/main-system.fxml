<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="salon_belleza.controller.MainSystemController">

   <top>
      <MenuBar>
         <Menu text="Archivo">
            <MenuItem onAction="#abrirCaja" text="Abrir Caja" />
            <MenuItem onAction="#cerrarCaja" text="Cerrar Caja" />
            <SeparatorMenuItem />
            <MenuItem onAction="#salir" text="Salir" />
         </Menu>
         <Menu text="Reportes">
            <MenuItem text="Ventas del Día" />
            <MenuItem text="Clientes Activos" />
            <MenuItem text="Inventario" />
         </Menu>
      </MenuBar>
   </top>

   <left>
      <VBox spacing="10" style="-fx-background-color: #f4f4f4; -fx-padding: 15;">
         <Button onAction="#cargarDashboard" style="-fx-font-size: 14; -fx-pref-width: 150;-fx-font-family: 'DejaVu Sans Mono'" text="📊 Principal" />

         <Button onAction="#cargarClientes" style="-fx-font-size: 14; -fx-pref-width: 150;" text="👥 Clientes" />

         <Button onAction="#cargarCitas" style="-fx-font-size: 14; -fx-pref-width: 150;" text="📅 Citas" />

         <Button onAction="#cargarServicios" style="-fx-font-size: 14; -fx-pref-width: 150;" text="💇 Servicios" />

         <Button onAction="#cargarInventario" style="-fx-font-size: 14; -fx-pref-width: 150;" text="📦 Inventario" />

         <Button onAction="#cargarVentas" style="-fx-font-size: 14; -fx-pref-width: 150;" text="💰 Ventas" />

         <Button onAction="#cargarEmpleados" style="-fx-font-size: 14; -fx-pref-width: 150;" text="‍💼 Empleados" />
      </VBox>
   </left>

   <center>
      <StackPane fx:id="contenedorModulos" style="-fx-padding: 20; -fx-background-color: white;" />
   </center>

   <bottom>
      <Label fx:id="lblEstado" style="-fx-padding: 5; -fx-background-color: #e0e0e0;" text="Sistema listo - Caja: No abierta" />
   </bottom>

</BorderPane>
