<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="salon_belleza.controller.ClienteController"
            style="-fx-background-color: #f8f9fa;">

    <top>
        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label text="Gestión de Clientes" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <Label text="Administre la información de sus clientes" style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="➕ Nuevo Cliente" onAction="#nuevoCliente"
                        style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 40; -fx-pref-width: 150;"/>
                <Button text="📊 Reportes" onAction="#generarReporte"
                        style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 40; -fx-pref-width: 120;"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscar" promptText="Buscar por nombre, teléfono o email..."
                           style="-fx-pref-width: 300; -fx-pref-height: 35;"/>
                <Button text="🔍 Buscar" onAction="#buscarClientes"
                        style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-pref-height: 35;"/>
                <ComboBox fx:id="cbFiltroEstado" promptText="Todos los estados"
                          style="-fx-pref-width: 150; -fx-pref-height: 35;"/>
                <Button text="🔄 Limpiar" onAction="#limpiarFiltros"
                        style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-pref-height: 35;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox style="-fx-padding: 20;" spacing="10">
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="lblContador" text="Cargando clientes..." style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
            </HBox>

            <TableView fx:id="tblClientes" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                <columns>
                    <TableColumn text="ID" prefWidth="60" fx:id="colId"/>
                    <TableColumn text="Nombre Completo" prefWidth="200" fx:id="colNombre"/>
                    <TableColumn text="Teléfono" prefWidth="120" fx:id="colTelefono"/>
                    <TableColumn text="Email" prefWidth="200" fx:id="colEmail"/>
                    <TableColumn text="Fecha Registro" prefWidth="120" fx:id="colFechaRegistro"/>
                    <TableColumn text="Última Visita" prefWidth="120" fx:id="colUltimaVisita"/>
                    <TableColumn text="Total Visitas" prefWidth="80" fx:id="colTotalVisitas"/>
                    <TableColumn text="Estado" prefWidth="100" fx:id="colEstado"/>
                    <TableColumn text="Acciones" prefWidth="150" fx:id="colAcciones"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox spacing="10" alignment="CENTER">
                <Button text="⏪ Anterior" onAction="#paginaAnterior"
                        style="-fx-background-color: transparent; -fx-border-color: #ddd;"/>
                <Label fx:id="lblPagina" text="Página 1 de 1" style="-fx-text-fill: #666;"/>
                <Button text="Siguiente ⏩" onAction="#paginaSiguiente"
                        style="-fx-background-color: transparent; -fx-border-color: #ddd;"/>
            </HBox>
        </VBox>
    </center>

    <right>
        <VBox fx:id="panelDetalle" visible="false" spacing="15"
              style="-fx-background-color: white; -fx-padding: 20; -fx-pref-width: 350; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Detalle del Cliente" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✕" onAction="#cerrarDetalle"
                        style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-font-size: 16px; -fx-cursor: hand;"/>
            </HBox>


            <VBox spacing="15">
                <VBox spacing="5">
                    <Label text="Nombre Completo *" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <TextField fx:id="txtNombre" promptText="Nombre y apellido"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Teléfono *" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <TextField fx:id="txtTelefono" promptText="+54 11 1234-5678"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Email" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <TextField fx:id="txtEmail" promptText="cliente@email.com"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Fecha de Nacimiento" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <DatePicker fx:id="dpFechaNacimiento"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Notas/Preferencias" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <TextArea fx:id="txtNotas" promptText="Notas sobre el cliente, preferencias, alergias..."
                              style="-fx-pref-height: 80;"/>
                </VBox>

                <VBox spacing="10">
                    <Button text="💾 Guardar Cambios" onAction="#guardarCliente"
                            style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 40;"/>
                    <Button text="🗑️ Eliminar Cliente" onAction="#eliminarCliente"
                            style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 40;"/>
                    <Button text="📅 Nueva Cita" onAction="#nuevaCitaCliente"
                            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 40;"/>
                </VBox>
            </VBox>
        </VBox>
    </right>

</BorderPane>