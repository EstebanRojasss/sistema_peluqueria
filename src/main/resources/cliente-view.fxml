<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="salon_belleza.controller.ClienteController">

    <top>
        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Gestión de Clientes" />
                    <Label style="-fx-text-fill: #666; -fx-font-size: 12px;" text="Administre la información de sus clientes" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#nuevoCliente" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 40; -fx-pref-width: 150;-fx-cursor: hand" text="➕ Nuevo Cliente" />
                <Button onAction="#generarReporte" style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 40; -fx-pref-width: 120;-fx-cursor: hand" text="📊 Reportes" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <TextField fx:id="txtBuscar" promptText="Buscar por nombre, teléfono o dni..." style="-fx-pref-width: 300; -fx-pref-height: 35;" />
                <Button onAction="#buscarClientes" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-pref-height: 35;-fx-cursor: hand" text="🔍 Buscar" />
                <Button onAction="#limpiarFiltros" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-pref-height: 35;-fx-cursor: hand" text="🔄 Limpiar" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" style="-fx-padding: 20;">
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="lblContador" style="-fx-text-fill: #666; -fx-font-size: 12px;" text="Cargando clientes..." visible="false" />
            </HBox>

            <TableView fx:id="tblClientes" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="100.0" text="ID" />
                    <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre Completo" />
                    <TableColumn fx:id="colTelefono" prefWidth="200.0" text="Teléfono" />
                    <TableColumn fx:id="colFechaRegistro" prefWidth="200.0" text="Fecha Registro" />
               <TableColumn fx:id="colDni" prefWidth="150.0" text="DNI" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER" spacing="10">
                <Button onAction="#paginaAnterior" style="-fx-background-color: transparent; -fx-border-color: #ddd;-fx-cursor: hand" text="⏪ Anterior" />
                <Label fx:id="lblPagina" style="-fx-text-fill: #666;" text="Página 1 de 1" />
                <Button onAction="#paginaSiguiente" style="-fx-background-color: transparent; -fx-border-color: #ddd;-fx-cursor: hand" text="Siguiente ⏩" />
            </HBox>
        </VBox>
    </center>
    <right>
        <VBox fx:id="panelAddCliente" spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-pref-width: 350; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Detalle del Cliente" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#cerrarDetalle" style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-font-size: 16px;-fx-cursor: hand;" text="✕" />
            </HBox>


            <VBox spacing="15">
                <VBox spacing="5">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #555;" text="Nombre Completo *" />
                    <TextField fx:id="txtNombreAddCliente" promptText="Nombre y apellido" />
                </VBox>

                <VBox spacing="5">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #555;" text="Teléfono *" />
                    <TextField fx:id="txtTelefonoAddCliente" promptText="+595 0912 123 456" />
                </VBox>

                <VBox spacing="5">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #555;" text="Cédula Identidad" />
               <TextField fx:id="txtDniAddCliente" promptText="x-xxx-xxx" />
                </VBox>

                <VBox spacing="10">
                    <Button onAction="#guardarCliente" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 40;-fx-cursor: hand" text="💾 Guardar Cambios" />
                    <Button onAction="#eliminarCliente" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 40;-fx-cursor: hand" text="🗑️ Eliminar Cliente" />
                    <Button onAction="#actualizarCliente" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 40;-fx-cursor: hand" text="📅 Actualizar  Cliente" />
                </VBox>
            </VBox>
        </VBox>
    </right>

</BorderPane>
